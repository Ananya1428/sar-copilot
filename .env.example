# Copy to .env and adjust as needed. Never commit the real .env.

# --- Postgres ---
DB_USER=sar
DB_PASSWORD=sarpass
DB_NAME=sarcopilot

# --- API ---
ENVIRONMENT=development
JWT_SECRET=change-me-in-production-use-a-real-secret
PROMPT_VERSION=v1.0.0
CORS_ORIGINS=*

# --- Redis (service is up from Part 1; not consumed by the API yet) ---
REDIS_URL=redis://redis:6379/0

# --- LLM runtime (service arrives in a later part; vars pre-declared here
#     so the api container's config surface doesn't change shape later) ---
OLLAMA_BASE_URL=http://ollama:11434
LLM_MODEL=llama3.1:8b-instruct-q4_K_M
